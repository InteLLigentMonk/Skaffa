{
  "expo": {
    "name": "Skaffa",
    "slug": "Skaffa",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skaffa",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/1914b705-fcca-43f7-9009-1e14880dd6da"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15803D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nu.skaffa.app",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#15803D",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Skaffa behöver tillgång till dina bilder för att du ska kunna lägga till en bild på receptet.",
          "cameraPermission": "Skaffa behöver tillgång till kameran för att du ska kunna fota receptet.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1914b705-fcca-43f7-9009-1e14880dd6da"
      }
    }
  }
}
